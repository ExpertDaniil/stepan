# API key/base URL are supplied by the platform. Fill locally; never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional; the proxy chooses the task model. The documented local default is:
OPENAI_MODEL=qwen/qwen3.8-27b

# Internal settings, not official platform variables.
LLM_MODE=live
WORK_DIR=./runs
TIME_BUDGET_SECONDS=10800
MAX_WORKERS=2
TRAIN_CPU_THREADS=3
TRAIN_MEMORY_MB=10240
EXPERIMENT_TIMEOUT_SECONDS=600
RESEARCH_SERIES_SIZE=4
# Search continues by remaining time; the legacy MAX_RESEARCH_EXPERIMENTS is ignored.
CATALOG_WARMUP_EXPERIMENTS=4
# adaptive enables explicit analysis/custom pipeline/tuning decisions; catalog/code retain legacy behavior.
RESEARCH_MODE=adaptive
LLM_MAX_CALLS=32
# One HTTP attempt; the whole dialogue has its own budget.
LLM_TIMEOUT_SECONDS=600
LLM_OPERATION_TIMEOUT_SECONDS=1200
# Research starts at 16k and can grow to 32k on truncation.
LLM_MAX_OUTPUT_TOKENS=16384
LLM_BOOTSTRAP_OUTPUT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS_LIMIT=32768
LLM_MAX_TOTAL_OUTPUT_TOKENS=262144
LLM_PROGRESS_SECONDS=15
MAX_CONTEXT_TOKENS=16000
SEED=42
# concise: short Russian progress; human: all fields; json: full JSONL.
CONSOLE_LOG_FORMAT=concise
LOG_LEVEL=INFO
LOG_MODEL_IO=1
# Optional compressed weights. Reconstruction uses code/parameters, not pickle.
MODEL_SNAPSHOT_MAX_BYTES=16777216
MODEL_SNAPSHOT_TOTAL_BYTES=67108864
WORKER_LOG_MAX_BYTES=1048576

# Persistent research graph (MAX_WORKERS remains the upper limit).
GRAPH_ENABLED=1
GRAPH_PEERS=2
GRAPH_TRAIN_WORKERS=1
GRAPH_MAX_LIVE_BRANCHES=3
GRAPH_MAX_TOTAL_BRANCHES=15
GRAPH_PLATEAU_WINDOW=4
GRAPH_PLATEAU_SECONDS=900
GRAPH_REFINEMENT_ENABLED=1
GRAPH_SEARCH_FRACTION=0.85
GRAPH_PLATEAU_ABSOLUTE_EPSILON=0.001
GRAPH_PLATEAU_RELATIVE_EPSILON=0.001
GRAPH_EXPLOIT_STEPS=3
GRAPH_MIN_EFFECT=0.001
GRAPH_CONTEXT_BYTES=48000
