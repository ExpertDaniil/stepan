# API key/base URL are supplied by the platform. Fill locally; never commit .env.
# Submission defaults are versioned in recipes/platform-env.json and embedded in the ZIP.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional; the proxy chooses the task model. The documented local default is:
OPENAI_MODEL=qwen/qwen3.8-27b

# Internal settings, not official platform variables.
AUTOML_PROFILE=platform
# CLI/platform default: platform (no numeric call/total-output quota).
# Explicit limits below still override that profile; use 0 for no numeric quota.
LLM_MODE=live
WORK_DIR=./runs
TIME_BUDGET_SECONDS=10800
MAX_WORKERS=2
TRAIN_CPU_THREADS=3
TRAIN_MEMORY_MB=10240
EXPERIMENT_TIMEOUT_SECONDS=600
RESEARCH_SERIES_SIZE=4
# Search continues by remaining time; the legacy MAX_RESEARCH_EXPERIMENTS is ignored.
CATALOG_WARMUP_EXPERIMENTS=4
# adaptive enables explicit analysis/custom pipeline/tuning decisions; catalog/code retain legacy behavior.
RESEARCH_MODE=adaptive
BACKGROUND_TUNING_ENABLED=1
# Batch size before review; the same Optuna study can continue beyond it.
BACKGROUND_MAX_TRIALS=128
BACKGROUND_TRIAL_SECONDS=300
BACKGROUND_CPU_THREADS=6
BACKGROUND_SWITCH_MARGIN=0
# Mandatory data-first window: auto = 1/6 of TIME_BUDGET_SECONDS (1800 s for 3 h).
# Set explicitly for a shorter experiment; 0 disables only this research policy.
# DATA_RESEARCH_MIN_SECONDS=1800
FEATURE_RESEARCH_ENABLED=1
# Generic statistical background seeds are opt-in; LLM research remains enabled.
FEATURE_SEED_BUDGET_FRACTION=0
FEATURE_SEED_TIMEOUT_SECONDS=120
# Evidence-grounded episodes and optional fit-only OOF discovery.
SCIENTIFIC_RESEARCH_ENABLED=1
RESEARCH_OOF_ENABLED=1
# 0 disables; positive legacy values allow renewable OOF with one diagnostic worker.
RESEARCH_OOF_JOBS=2
RESEARCH_OOF_ROWS=10000
RESEARCH_OOF_TIMEOUT_SECONDS=90
RESEARCH_OOF_BUDGET_FRACTION=0.04
RESEARCH_EPISODE_BUDGET_FRACTION=0.15
RESEARCH_DEEP_DIALOGUE_SECONDS=600
LLM_RESEARCH_TOOL_SECONDS=90
LLM_RESEARCH_DIALOGUE_SECONDS=900
LLM_MAX_CALLS=0
# One HTTP attempt; the whole dialogue has its own budget.
LLM_TIMEOUT_SECONDS=600
LLM_OPERATION_TIMEOUT_SECONDS=1200
# Research starts at 32k and can grow to 64k on truncation.
LLM_MAX_OUTPUT_TOKENS=32768
LLM_BOOTSTRAP_OUTPUT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS_LIMIT=65536
# 0 disables this internal run quota; external provider budget/deadline still apply.
LLM_MAX_TOTAL_OUTPUT_TOKENS=1048576
LLM_RESEARCH_TOOL_TURNS=8
# Full serialized request ceiling. Graph adaptive also obeys GRAPH_CONTEXT_BYTES.
LLM_REQUEST_MAX_BYTES=196608
LLM_CONTEXT_WINDOW_TOKENS=262144
# Optional provider protocol. Compatible default sends no unconfirmed Qwen controls.
LLM_REASONING_PROTOCOL=compatible
LLM_REASONING_FIELD=reasoning_content
# Only after verifying the proxy contract: qwen_chat_template + low/medium/xhigh.
# LLM_REASONING_EFFORT=xhigh
LLM_REASONING_HISTORY_BYTES=32768
LLM_PROGRESS_SECONDS=15
MAX_CONTEXT_TOKENS=16000
SEED=42
CONSOLE_LOG_FORMAT=human
LOG_LEVEL=INFO
LOG_MODEL_IO=1
# Optional compressed weights. Reconstruction uses code/parameters, not pickle.
MODEL_SNAPSHOT_MAX_BYTES=16777216
MODEL_SNAPSHOT_TOTAL_BYTES=67108864
WORKER_LOG_MAX_BYTES=1048576

# Persistent research graph (MAX_WORKERS remains the upper limit).
GRAPH_ENABLED=1
GRAPH_PEERS=2
GRAPH_TRAIN_WORKERS=1
GRAPH_MAX_LIVE_BRANCHES=3
GRAPH_MAX_TOTAL_BRANCHES=15
GRAPH_PLATEAU_WINDOW=6
GRAPH_PLATEAU_SECONDS=1800
# Empirical forks are revisable preferences; 1 explicitly opts into strict locks.
GRAPH_HARD_DECISIONS=0
GRAPH_BRANCH_MIN_SECONDS=600
GRAPH_REFINEMENT_ENABLED=1
GRAPH_SEARCH_FRACTION=0.85
GRAPH_PLATEAU_ABSOLUTE_EPSILON=0.001
GRAPH_PLATEAU_RELATIVE_EPSILON=0.001
GRAPH_EXPLOIT_STEPS=3
GRAPH_MIN_EFFECT=0.001
# 192 KiB complete graph requests, including schema/tools/feedback/repair.
GRAPH_CONTEXT_BYTES=196608

# Open research: optional legacy comparator, not an initial model-tuning barrier.
RESEARCH_PROTOCOL=compact
PYTHON_ANALYSIS_ENABLED=1
# Unset uses 1/6 of the run (30 minutes for 3 hours); explicit 0 disables it.
